{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "pnpm --filter @apiary-dev/core build && pnpm --filter @apiary-dev/postgres build",
    "typecheck": "pnpm --filter @apiary-dev/core exec tsc -p tsconfig.json && pnpm --filter @apiary-dev/postgres exec tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "publish": "pnpm build && pnpm -r publish --access public --force",
    "publish:dry": "pnpm build && pnpm -r publish --dry-run --access public --force --no-git-checks"
  }
}
