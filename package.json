{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "pnpm --filter @apiary/core build && pnpm --filter @apiary/postgres build",
    "typecheck": "pnpm --filter @apiary/core exec tsc -p tsconfig.json && pnpm --filter @apiary/postgres exec tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration"
  }
}
